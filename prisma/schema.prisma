generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  passwordHash            String
  roleId                  String
  role                    Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive                Boolean                  @default(true)
  emailVerified           DateTime?
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  employee                Employee?
  notifications           Notification[]
  auditLogs               AuditLog[]
  preference              UserPreference?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([roleId])
  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  description     String?
  module          String
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Branch {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  address     String
  city        String
  state       String?
  postalCode  String?
  phone       String?
  email       String?
  openingTime String?      // HH:mm format
  closingTime String?      // HH:mm format
  status      BranchStatus @default(ACTIVE)
  employees   Employee[]
  shifts      Shift[]
  attendances Attendance[]
  menuItems         BranchMenuItem[]
  inventoryItems    InventoryItem[]
  stockTransactions StockTransaction[]
  purchaseOrders    PurchaseOrder[]
  tables            RestaurantTable[]
  orders            Order[]
  payments          Payment[]
  paymentReconciliations PaymentReconciliation[]
  expenses          Expense[]
  expenseTemplates  ExpenseTemplate[]
  salaryStructures  SalaryStructure[]
  salaryIncrements  SalaryIncrement[]
  bonuses           Bonus[]
  incentives        Incentive[]
  salaryRecords     SalaryRecord[]
  reviews           Review[]
  issues            CustomerIssue[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  settings          SystemSetting[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([city])
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

enum SalaryType {
  MONTHLY
  DAILY
  HOURLY
}

model Employee {
  id                    String           @id @default(cuid())
  employeeCode          String           @unique
  firstName             String
  lastName              String
  phone                 String
  email                 String?
  dateOfBirth           DateTime?
  joiningDate           DateTime
  designation           String
  branchId              String
  branch                Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  currentShiftId        String?
  currentShift          Shift?           @relation("EmployeeCurrentShift", fields: [currentShiftId], references: [id], onDelete: SetNull)
  employmentStatus      EmploymentStatus @default(ACTIVE)
  salary                Decimal          @db.Decimal(10, 2)
  salaryType            SalaryType       @default(MONTHLY)
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  userId                String?          @unique
  user                  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendances           Attendance[]
  salaryStructures      SalaryStructure[]
  salaryIncrements      SalaryIncrement[]
  bonuses               Bonus[]
  incentives            Incentive[]
  salaryRecords         SalaryRecord[]
  assignedIssues        CustomerIssue[]  @relation("AssignedIssues")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([branchId])
  @@index([employmentStatus])
  @@index([phone])
  @@index([joiningDate])
  @@index([designation])
}

enum ShiftStatus {
  ACTIVE
  INACTIVE
}

model Shift {
  id          String       @id @default(cuid())
  name        String
  branchId    String
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  startTime   String       // HH:mm format (e.g. "09:00")
  endTime     String       // HH:mm format (e.g. "17:00")
  status      ShiftStatus  @default(ACTIVE)
  employees   Employee[]   @relation("EmployeeCurrentShift")
  attendances Attendance[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([branchId])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

model Attendance {
  id                    String           @id @default(cuid())
  employeeId            String
  employee              Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branchId              String
  branch                Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shiftId               String?
  shift                 Shift?           @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  date                  DateTime         @db.Date
  status                AttendanceStatus @default(PRESENT)
  checkIn               DateTime?
  checkOut              DateTime?
  lateMinutes           Int              @default(0)
  earlyDepartureMinutes Int              @default(0)
  note                  String?
  markedBy              String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([branchId, date])
  @@index([employeeId, date])
  @@index([status])
  @@index([shiftId])
}

// ─── Menu & Recipe / BOM Management ─────────────────────────────────────────

enum MenuStatus {
  ACTIVE
  INACTIVE
}

enum IngredientUnit {
  KG
  GRAM
  LITRE
  ML
  PIECE
  PACK
  DOZEN
}

model MenuCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  status      MenuStatus @default(ACTIVE)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([sortOrder])
}

model Ingredient {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  unit        IngredientUnit
  status      MenuStatus         @default(ACTIVE)
  recipes            RecipeIngredient[]
  inventoryItems     InventoryItem[]
  stockTransactions  StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  receivingItems     PurchaseReceivingItem[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
  @@index([name])
}

model MenuItem {
  id                     String             @id @default(cuid())
  name                   String
  description            String?
  categoryId             String
  category               MenuCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price                  Decimal            @db.Decimal(10, 2)
  preparationTimeMinutes Int                @default(0)
  imageUrl               String?
  status                 MenuStatus         @default(ACTIVE)
  branchAvailability     BranchMenuItem[]
  recipeIngredients      RecipeIngredient[]
  orderItems             OrderItem[]
  reviews                Review[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([name])
}

model BranchMenuItem {
  id          String     @id @default(cuid())
  branchId    String
  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  menuItemId  String
  menuItem    MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  price       Decimal?   @db.Decimal(10, 2)
  isAvailable Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([branchId, menuItemId])
  @@index([branchId])
  @@index([menuItemId])
}

model RecipeIngredient {
  id           String         @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal        @db.Decimal(10, 3)
  unit         IngredientUnit
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
}

// ─── Inventory & Stock Management ───────────────────────────────────────────

enum InventoryStatus {
  ACTIVE
  INACTIVE
}

enum StockTransactionType {
  OPENING
  RECEIPT
  CONSUMPTION
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  WASTAGE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum WastageReason {
  BURNED
  SPILLED
  SPOILED
  EXPIRED
  DROPPED
  OVER_PREPARED
  PREPARATION_ERROR
  DELIVERY_DAMAGE
  PACKAGING_DAMAGE
  OTHER
}

model InventoryItem {
  id           String          @id @default(cuid())
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ingredientId String
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  minimumStock Decimal         @default(0) @db.Decimal(10, 3)
  reorderLevel Decimal         @default(0) @db.Decimal(10, 3)
  status       InventoryStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([branchId, ingredientId])
  @@index([branchId])
  @@index([ingredientId])
  @@index([status])
}

model StockTransaction {
  id           String               @id @default(cuid())
  branchId     String
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ingredientId String
  ingredient   Ingredient           @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  type         StockTransactionType
  quantity     Decimal              @db.Decimal(10, 3)
  unit         IngredientUnit
  referenceId  String?
  reason       WastageReason?
  note         String?
  performedBy  String
  createdAt    DateTime             @default(now())

  @@index([branchId, ingredientId])
  @@index([branchId, createdAt])
  @@index([ingredientId, createdAt])
  @@index([type])
  @@index([referenceId])
}

// ─── Suppliers & Purchase Management ────────────────────────────────────────

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  postalCode    String?
  notes         String?
  status        SupplierStatus  @default(ACTIVE)
  purchaseOrders PurchaseOrder[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([name])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  purchaseNumber String              @unique
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  notes          String?
  createdBy      String
  items          PurchaseOrderItem[]
  receivingLogs  PurchaseReceiving[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([supplierId])
  @@index([branchId])
  @@index([status])
  @@index([orderDate])
  @@index([purchaseNumber])
}

model PurchaseOrderItem {
  id              String                  @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient              @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  orderedQuantity Decimal                 @db.Decimal(10, 3)
  unit            IngredientUnit
  unitPrice       Decimal                 @db.Decimal(10, 2)
  receivedQuantity Decimal                @default(0) @db.Decimal(10, 3)
  receivingItems  PurchaseReceivingItem[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([purchaseOrderId, ingredientId])
  @@index([purchaseOrderId])
  @@index([ingredientId])
}

model PurchaseReceiving {
  id              String                  @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivingNumber String                  @unique
  receivedBy      String
  receivedAt      DateTime                @default(now())
  notes           String?
  items           PurchaseReceivingItem[]
  createdAt       DateTime                @default(now())

  @@index([purchaseOrderId])
  @@index([receivedAt])
}

model PurchaseReceivingItem {
  id                  String            @id @default(cuid())
  receivingId         String
  receiving           PurchaseReceiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  ingredientId        String
  ingredient          Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity            Decimal           @db.Decimal(10, 3)
  unit                IngredientUnit
  createdAt           DateTime          @default(now())

  @@index([receivingId])
  @@index([purchaseOrderItemId])
  @@index([ingredientId])
}

// ─── Order Management — Dine-in, Takeaway & Delivery ────────────────────────

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  phone     String?        @unique
  email     String?
  address   String?
  notes     String?
  status    CustomerStatus @default(ACTIVE)
  orders    Order[]
  reviews   Review[]
  issues    CustomerIssue[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([phone])
  @@index([name])
  @@index([status])
}

model RestaurantTable {
  id          String      @id @default(cuid())
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  tableNumber String
  capacity    Int         @default(4)
  status      TableStatus @default(AVAILABLE)
  orders      Order[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([branchId, tableNumber])
  @@index([branchId])
  @@index([status])
  @@map("restaurant_tables")
}

model Order {
  id                 String           @id @default(cuid())
  orderNumber        String           @unique
  branchId           String
  branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orderType          OrderType
  status             OrderStatus      @default(PENDING)
  customerId         String?
  customer           Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tableId            String?
  table              RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerName       String?
  customerPhone      String?
  deliveryAddress    String?
  deliveryNotes      String?
  subtotal           Decimal          @db.Decimal(10, 2)
  discountAmount     Decimal          @default(0) @db.Decimal(10, 2)
  taxAmount          Decimal          @default(0) @db.Decimal(10, 2)
  deliveryCharge     Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal          @db.Decimal(10, 2)
  notes              String?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?
  createdBy          String
  confirmedAt        DateTime?
  preparingAt        DateTime?
  readyAt            DateTime?
  completedAt        DateTime?
  preparedBy         String?
  readyBy            String?
  completedBy        String?
  inventoryConsumed  Boolean          @default(false)
  inventoryConsumedAt DateTime?
  items              OrderItem[]
  auditLogs          OrderAuditLog[]
  payments           Payment[]
  reviews            Review[]
  issues             CustomerIssue[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([branchId])
  @@index([orderNumber])
  @@index([status])
  @@index([orderType])
  @@index([createdAt])
  @@index([customerId])
  @@index([tableId])
  @@index([branchId, status])
  @@index([status, createdAt])
  @@index([branchId, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  itemName       String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  totalPrice     Decimal  @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
  @@index([menuItemId])
}

model OrderAuditLog {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus
  toStatus    OrderStatus
  performedBy String
  userId      String?
  notes       String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// ─── Payments & Payment Reconciliation ──────────────────────────────────────

enum PaymentMethod {
  CASH
  UPI
  CARD
  ONLINE
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum ReconciliationStatus {
  OPEN
  RECONCILED
}

model Payment {
  id                   String          @id @default(cuid())
  paymentNumber        String          @unique // e.g. PAY-2026-000001
  orderId              String
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  branchId             String
  branch               Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amount               Decimal         @db.Decimal(10, 2)
  method               PaymentMethod
  status               PaymentStatus   @default(SUCCESS)
  referenceNumber      String?
  notes                String?
  processedBy          String
  processedAt          DateTime        @default(now())

  // Extensibility fields for future payment gateway integrations
  gatewayProvider      String?
  gatewayTransactionId String?
  gatewayStatus        String?
  gatewayMetadata      Json?

  refunds              PaymentRefund[]
  auditLogs            PaymentAuditLog[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([orderId])
  @@index([branchId])
  @@index([status])
  @@index([method])
  @@index([processedAt])
  @@index([referenceNumber])
  @@index([paymentNumber])
  @@index([branchId, processedAt])
  @@index([branchId, status])
}

model PaymentRefund {
  id              String        @id @default(cuid())
  refundNumber    String        @unique // e.g. REF-2026-000001
  paymentId       String
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(10, 2)
  reason          String
  status          RefundStatus  @default(SUCCESS)
  processedBy     String
  processedAt     DateTime      @default(now())
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([processedAt])
  @@index([refundNumber])
}

model PaymentReconciliation {
  id           String               @id @default(cuid())
  branchId     String
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  date         DateTime             @db.Date
  systemCash   Decimal              @db.Decimal(10, 2)
  actualCash   Decimal              @db.Decimal(10, 2)
  variance     Decimal              @db.Decimal(10, 2)
  note         String?
  reconciledBy String
  reconciledAt DateTime             @default(now())
  status       ReconciliationStatus @default(OPEN)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([branchId, date])
  @@index([branchId])
  @@index([date])
  @@index([status])
}

model PaymentAuditLog {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  action      String   // 'PAYMENT_CREATED', 'PAYMENT_FAILED', 'REFUND_CREATED', 'STATUS_CHANGE'
  fromStatus  String?
  toStatus    String?
  amount      Decimal? @db.Decimal(10, 2)
  performedBy String
  notes       String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@index([createdAt])
}

// ─── Expenses Management ───────────────────────────────────────────────────

enum ExpenseCategoryStatus {
  ACTIVE
  INACTIVE
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum ExpenseFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum ExpenseTemplateStatus {
  ACTIVE
  INACTIVE
}

model ExpenseCategory {
  id          String                @id @default(cuid())
  name        String                @unique
  description String?
  status      ExpenseCategoryStatus @default(ACTIVE)
  expenses    Expense[]
  templates   ExpenseTemplate[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status])
  @@index([name])
}

model Expense {
  id                 String           @id @default(cuid())
  expenseNumber      String           @unique // e.g. EXP-2026-000001
  branchId           String
  branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  categoryId         String
  category           ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount             Decimal          @db.Decimal(10, 2)
  expenseDate        DateTime         @db.Date
  description        String
  vendorName         String?
  paymentMethod      PaymentMethod
  referenceNumber    String?
  status             ExpenseStatus    @default(PENDING_APPROVAL)
  receiptUrl         String?
  notes              String?
  rejectionReason    String?
  cancellationReason String?
  cancelledBy        String?
  cancelledAt        DateTime?
  createdBy          String
  approvedBy         String?
  approvedAt         DateTime?
  templateId         String?
  template           ExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  auditLogs          ExpenseAuditLog[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([branchId])
  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
  @@index([paymentMethod])
  @@index([expenseNumber])
  @@index([branchId, expenseDate])
  @@index([branchId, status])
  @@index([createdBy])
}

model ExpenseTemplate {
  id            String                @id @default(cuid())
  branchId      String
  branch        Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  categoryId    String
  category      ExpenseCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description   String
  amount        Decimal               @db.Decimal(10, 2)
  frequency     ExpenseFrequency
  nextDueDate   DateTime              @db.Date
  status        ExpenseTemplateStatus @default(ACTIVE)
  vendorName    String?
  paymentMethod PaymentMethod?
  createdBy     String
  expenses      Expense[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([branchId])
  @@index([categoryId])
  @@index([status])
  @@index([nextDueDate])
}

model ExpenseAuditLog {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  action      String   // 'CREATED', 'SUBMITTED_FOR_APPROVAL', 'APPROVED', 'REJECTED', 'CANCELLED', 'UPDATED'
  fromStatus  String?
  toStatus    String?
  amount      Decimal? @db.Decimal(10, 2)
  performedBy String
  notes       String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([expenseId])
  @@index([createdAt])
}

// ─── Salary, Bonus & Increment Management ─────────────────────────────────────

enum SalaryStructureStatus {
  ACTIVE
  SUPERSEDED
  CANCELLED
}

enum BonusType {
  PERFORMANCE
  FESTIVAL
  ATTENDANCE
  SALES_INCENTIVE
  SPECIAL
  OTHER
}

enum BonusStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum IncrementStatus {
  APPLIED
  CANCELLED
}

enum SalaryRecordStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PAID
  CANCELLED
}

model SalaryStructure {
  id            String                @id @default(cuid())
  employeeId    String
  employee      Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branchId      String
  branch        Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  salary        Decimal               @db.Decimal(10, 2)
  salaryType    SalaryType            @default(MONTHLY)
  effectiveFrom DateTime              @db.Date
  effectiveTo   DateTime?             @db.Date
  reason        String?
  status        SalaryStructureStatus @default(ACTIVE)
  createdBy     String
  increments    SalaryIncrement[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([employeeId, effectiveFrom])
  @@index([branchId])
  @@index([status])
}

model SalaryIncrement {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branchId          String
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  previousSalary    Decimal          @db.Decimal(10, 2)
  newSalary         Decimal          @db.Decimal(10, 2)
  difference        Decimal          @db.Decimal(10, 2)
  percentage        Decimal          @db.Decimal(5, 2)
  effectiveDate     DateTime         @db.Date
  reason            String?
  notes             String?
  status            IncrementStatus  @default(APPLIED)
  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  createdBy         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([employeeId])
  @@index([branchId])
  @@index([effectiveDate])
}

model Bonus {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(10, 2)
  type            BonusType     @default(PERFORMANCE)
  reason          String
  bonusDate       DateTime      @db.Date
  status          BonusStatus   @default(DRAFT)
  rejectionReason String?
  salaryRecordId  String?
  salaryRecord    SalaryRecord? @relation(fields: [salaryRecordId], references: [id], onDelete: SetNull)
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?
  cancelledBy     String?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId])
  @@index([branchId])
  @@index([status])
  @@index([bonusDate])
  @@index([salaryRecordId])
}

model Incentive {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(10, 2)
  reason          String
  incentiveDate   DateTime      @db.Date
  status          BonusStatus   @default(APPROVED)
  rejectionReason String?
  salaryRecordId  String?
  salaryRecord    SalaryRecord? @relation(fields: [salaryRecordId], references: [id], onDelete: SetNull)
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?
  cancelledBy     String?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId])
  @@index([branchId])
  @@index([status])
  @@index([incentiveDate])
  @@index([salaryRecordId])
}

model SalaryRecord {
  id                 String             @id @default(cuid())
  salaryNumber       String             @unique // e.g. SAL-2026-000001
  employeeId         String
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branchId           String
  branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  periodStart        DateTime           @db.Date
  periodEnd          DateTime           @db.Date
  baseSalary         Decimal            @db.Decimal(10, 2)
  bonusAmount        Decimal            @default(0) @db.Decimal(10, 2)
  incentiveAmount    Decimal            @default(0) @db.Decimal(10, 2)
  adjustmentAmount   Decimal            @default(0) @db.Decimal(10, 2)
  grossAmount        Decimal            @db.Decimal(10, 2)
  status             SalaryRecordStatus @default(DRAFT)
  notes              String?
  attendanceSummary  Json?
  bonuses            Bonus[]
  incentives         Incentive[]
  auditLogs          SalaryAuditLog[]
  createdBy          String
  approvedBy         String?
  approvedAt         DateTime?
  cancelledBy        String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([employeeId])
  @@index([branchId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([salaryNumber])
}

model SalaryAuditLog {
  id             String       @id @default(cuid())
  salaryRecordId String
  salaryRecord   SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)
  action         String       // 'CREATED', 'SUBMITTED_FOR_REVIEW', 'APPROVED', 'CANCELLED', 'REVISED'
  fromStatus     String?
  toStatus       String?
  grossAmount    Decimal?     @db.Decimal(10, 2)
  performedBy    String
  notes          String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([salaryRecordId])
  @@index([createdAt])
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  RESOLVED
}

model Review {
  id          String       @id @default(cuid())
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  branchId    String
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  menuItemId  String?
  menuItem    MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  rating      Int          // 1 to 5
  title       String?
  comment     String?
  status      ReviewStatus @default(PENDING)
  moderatedBy String?
  moderatedAt DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([orderId])
  @@index([menuItemId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
}

enum IssueType {
  FOOD_QUALITY
  WRONG_ORDER
  MISSING_ITEM
  LATE_ORDER
  PAYMENT
  STAFF_SERVICE
  CLEANLINESS
  DELIVERY
  OTHER
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

model CustomerIssue {
  id             String                  @id @default(cuid())
  issueNumber    String                  @unique // ISS-YYYY-000001
  customerId     String?
  customer       Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  branchId       String
  branch         Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type           IssueType
  priority       IssuePriority           @default(MEDIUM)
  description    String
  status         IssueStatus             @default(OPEN)
  assignedTo     String?
  assignedStaff  Employee?               @relation("AssignedIssues", fields: [assignedTo], references: [id], onDelete: SetNull)
  resolutionNote String?
  createdBy      String
  resolvedBy     String?
  resolvedAt     DateTime?
  auditLogs      CustomerIssueAuditLog[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([orderId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([createdAt])
}

model CustomerIssueAuditLog {
  id          String        @id @default(cuid())
  issueId     String
  issue       CustomerIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  action      String
  fromStatus  IssueStatus?
  toStatus    IssueStatus?
  performedBy String
  userId      String?
  notes       String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  @@index([issueId])
  @@index([createdAt])
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  STOCK_VARIANCE
  HIGH_WASTAGE
  PENDING_EXPENSE_APPROVAL
  PENDING_BONUS_APPROVAL
  PENDING_SALARY_REVIEW
  FAILED_PAYMENT
  UNPAID_ORDER
  ATTENDANCE_ALERT
  OPERATIONAL_EXCEPTION
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id              String               @id @default(cuid())
  recipientUserId String
  recipient       User                 @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type            NotificationType
  severity        NotificationSeverity @default(INFO)
  title           String
  message         String
  entityType      String?
  entityId        String?
  actionUrl       String?
  isRead          Boolean              @default(false)
  readAt          DateTime?
  isDismissed     Boolean              @default(false)
  dismissedAt     DateTime?
  dedupeKey       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([recipientUserId])
  @@index([branchId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@index([dedupeKey])
  @@index([recipientUserId, isRead, isDismissed])
}

model AuditLog {
  id           String    @id @default(cuid())
  actorUserId  String?
  actorUser    User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  description  String
  beforeData   Json?
  afterData    Json?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([actorUserId])
  @@index([branchId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([branchId, createdAt])
  @@index([entityType, entityId])
}

enum SettingScope {
  GLOBAL
  BRANCH
}

enum SettingDataType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  TIME
}

model SystemSetting {
  id          String          @id @default(cuid())
  key         String
  value       String          @db.Text
  scope       SettingScope    @default(GLOBAL)
  branchId    String?
  branch      Branch?         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  description String?
  dataType    SettingDataType @default(STRING)
  updatedBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([key])
  @@index([scope])
  @@index([branchId])
  @@index([key, branchId])
}

model UserPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme             String   @default("system")
  tableDensity      String   @default("comfortable")
  defaultDateRange  String   @default("30d")
  preferredBranchId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

